        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この商品の基準モデルは使用できません。寸法の記録は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 상품의 기준 모델을 사용할 수 없습니다. 치수 기록은 보존됩니다."
          }
        }
      }
    },
    "이 상품의 사이즈 치수를 기록합니다." : {
      "localizations" : {
