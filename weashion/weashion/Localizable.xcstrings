          }
        }
      }
    },
    "이 상품에 같은 사이즈명이 있습니다. 다른 이름을 사용하거나 기존 사이즈를 수정해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This product already has a size with that label. Use another name or edit the existing size."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この商品には同じサイズ名があります。別の名前を使うか、既存のサイズを編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 상품에 같은 사이즈명이 있습니다. 다른 이름을 사용하거나 기존 사이즈를 수정해 주세요."
          }
        }
      }
    },
    "이 상품에 사이즈를 추가해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
