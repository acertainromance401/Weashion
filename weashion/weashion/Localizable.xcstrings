          "stringUnit" : {
            "state" : "translated",
            "value" : "Where today’s air meets your body.\nSketch the day’s outfit in WEASHION."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の空気と自分の体型が出会う場所。\nWEASHIONで一日の装いを描いてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 공기와 나의 체형이 만나는 곳.\nWEASHION에서 하루의 옷차림을 그려보세요."
          }
