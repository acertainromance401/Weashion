        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weather uses location permission only when you connect it from Today. Fitting works without it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気は「今日」画面で接続を求めたときにだけ位置情報を使います。接続しなくてもフィッティングは使えます。"
          }
        },
        "ko" : {
