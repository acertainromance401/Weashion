    "다음" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次へ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음"
          }
        }
      }
    },
    "단면 × 2와 신체 둘레를 비교한 근사값입니다. 실제 원단의 신축률·착용감과 다를 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An approximate comparison of flat width × 2 with body circumference. Actual fabric stretch and wearing comfort may differ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平置き幅 × 2と身体の周囲寸法を比較した近似値です。実際の生地の伸縮率や着心地とは異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단면 × 2와 신체 둘레를 비교한 근사값입니다. 실제 원단의 신축률·착용감과 다를 수 있습니다."
          }
        }
      }
    },
    "단면 × 2와 신체 둘레의 근사 비교이며 실제 착용감과 다를 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An approximate comparison of flat width × 2 with body circumference. Actual wearing comfort may differ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平置き幅 × 2と身体の周囲寸法の近似比較であり、実際の着心地とは異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단면 × 2와 신체 둘레의 근사 비교이며 실제 착용감과 다를 수 있습니다."
          }
        }
      }
    },
    "단면은 평평하게 놓은 바지의 폭입니다. 둘레 비교에는 단면 × 2를 사용합니다. 인심은 가랑이에서 밑단까지의 길이입니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat width is measured with the trousers laid flat. Circumference comparisons use flat width × 2. Inseam runs from the crotch to the hem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平置き幅はパンツを平らに置いて測る幅です。周囲寸法の比較には平置き幅 × 2を使います。股下は股から裾までの長さです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단면은 평평하게 놓은 바지의 폭입니다. 둘레 비교에는 단면 × 2를 사용합니다. 인심은 가랑이에서 밑단까지의 길이입니다."
          }
        }
      }
    },
    "단면의 두 배도 둘레의 대략적인 참고값입니다. 다트·주름·입체 패턴·착용 여유·소재의 신축성에 따라 달라집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twice the flat width is only a rough guide to girth. Darts, pleats, shaped patterns, wearing ease and stretch all change it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身幅の2倍も周囲の目安にすぎません。ダーツ・プリーツ・立体パターン・着用ゆとり・素材の伸びで変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단면의 두 배도 둘레의 대략적인 참고값입니다. 다트·주름·입체 패턴·착용 여유·소재의 신축성에 따라 달라집니다."
          }
        }
      }
    },
